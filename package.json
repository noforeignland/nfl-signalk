{
  "name": "@noforeignland/signalk-to-noforeignland",
  "signalk": {
    "id": "@noforeignland/signalk-to-noforeignland",
    "displayName": "Signal K to Noforeignland",
    "appIcon": "./doc/logo/nfl-logo-red-round.png",
    "screenshots": [
      "./doc/screenshots/1_nfl_phone-8.jpg",
      "./doc/screenshots/2_nfl_phone-7.jpg"
    ]
  },
  "version": "1.3.1",
  "description": "SignalK track logger to noforeignland.com",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "doc/logo",
    "doc/screenshots"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility"
  ],
  "author": "Dirk Wahrheit",
  "license": "MIT",
  "homepage": "https://github.com/noforeignland/nfl-signalk",
  "bugs": {
    "url": "https://github.com/noforeignland/nfl-signalk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noforeignland/nfl-signalk.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "eslint src test --fix && prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "dependencies": {
    "cron": "^4.4.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@signalk/server-api": "^2.10.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.14",
    "@types/node-fetch": "^2.6.12",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "mock-fs": "^5.4.1",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
